<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Barbee Hive App</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>barbee_hive_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Add the permissions for camera and gallery -->
    <key>NSCameraUsageDescription</key>
    <string>Barbee Inc. needs permission to register and edit profile.</string>

    <key>NSPhotoLibraryUsageDescription</key>
    <string>Barbee Inc. needs permission to register and edit profile.</string>

    <!-- Add the permissions for camera and gallery -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Barbee Inc needs permission to find nearby users.</string>

    <key>NSLocationAlwaysUsageDescription</key>
    <string>Barbee Inc needs permission to find nearby users.</string>


	<!-- Add the AdMob Application ID here -->
    <key>GADApplicationIdentifier</key>
    <string>ca-app-pub-7197948477323178~9756279016</string>

    <!-- URL Schemes for Stripe and Google Sign-In -->
    <key>CFBundleURLTypes</key>
    <array>
        <!-- Stripe URL Scheme -->
        <dict>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>stripe</string>
            </array>
        </dict>
        <!-- Google Sign-In URL Scheme -->
        <!-- TODO: Replace with your REVERSED_CLIENT_ID from Firebase Console -->
        <!-- Get it from: Firebase Console > Project Settings > iOS App > OAuth 2.0 Client ID -->
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>com.googleusercontent.apps.545979703872-5m6fb3en9nt5revti6td10ndkn3gpqod</string>
            </array>
        </dict>
    </array>

    <!-- Apple Pay Merchant Identifier -->
    <key>merchantIdentifier</key>
    <string>merchant.app.barbeeinc</string>

    <!-- Stripe Apple Pay Settings -->
    <key>com.stripe.react-native.payments</key>
    <dict>
        <key>merchantIdentifier</key>
        <string>merchant.app.barbeeinc</string>
        <key>enableApplePay</key>
        <true/>
    </dict>

    <!-- Allow Stripe Redirect Handling -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>stripe</string>
    </array>


</dict>
</plist>
